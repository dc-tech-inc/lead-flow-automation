# Copy to .env and adjust. Never commit real secrets.
PORT=3000
# Shared secret used to sign webhooks (HMAC-SHA256). Generate one: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Leave empty to use the in-memory store (data is lost on restart).
DATABASE_URL=
# Serve the built-in fake CRM and fake enrichment API under /fake/*.
ENABLE_FAKES=true
# Base URLs of the CRM and enrichment APIs (defaults point at the built-in fakes).
CRM_URL=
ENRICH_URL=
# Fill an empty database with synthetic leads on start (demo only).
SEED_ON_START=false
# Encrypts credentials stored by n8n (docker compose only). Generate one: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-another-long-random-string
