{
  "name": "lead-flow-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Lead intake service: signed webhooks, third-party clients with retry, fake CRM and a response-time/conversion dashboard over synthetic data.",
  "license": "MIT",
  "author": "DC TECH INC",
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "seed": "tsx src/seed-cli.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "^26",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
